INICIO, INPUT 
		STORE OPC
		LOAD OPC
		SUBT UNO
		SkipCond 400// =0
		JUMP CASO_2
		JNS CONVERTIR_MINUS
		JUMP INICIO

CASO_2, LOAD OPC
		SUBT DOS
		SkipCond 400
		JUMP CASO_3
		JNS CONVERTIR_MAYUS
		JUMP INICIO

CASO_3, LOAD OPC
		SUBT TRES
		SkipCond 400
		JUMP CASO_4
		JNS MOSTRAR
		JUMP INICIO

CASO_4, LOAD OPC
		SUBT CUATRO
		SkipCond 400
		JUMP INICIO
		Halt

//SUBRUTINAS
CONVERTIR_MINUS, HEX 0
		LOAD INICIO_CADENA//GUARDAR DIRECCION DE INICIO_CADENA
		STORE PTR//ALMACENAR LA DIRECCION EN PUNTERO
//CICLO QUE RECORRE LA CADENA Y CARGA LA LETRA, TERMINA CUANDO =0
RECORRER_MINUS, LOADI PTR
				SkipCond 400
				JUMP VERIFICAR_MINUS
				JUMP FIN_MINUS

VERIFICAR_MINUS, LOADI PTR
			SUBT A// 'A' = 65
			SkipCond 000// < 0
			JUMP RANGO_MAYUS
			JUMP SIGUIENTE

RANGO_MAYUS, LOADI PTR
			SUBT Z// 'Z' = 90
			SkipCond 800 // > 0
			JUMP SUMA_32
			JUMP SIGUIENTE

SUMA_32, LOADI PTR
		ADD DIF
		STOREI PTR

SIGUIENTE, LOAD PTR
		ADD UNO
		STORE PTR
		JUMP RECORRER_MINUS
		
FIN_MINUS, JumpI CONVERTIR_MINUS

//
CONVERTIR_MAYUS, HEX 0 
			LOAD INICIO_CADENA
			STORE PTR

RECORRER_MAYUS, LOADI PTR
			SkipCond 400 // = 0
			JUMP VERIFICAR_MAYUS
			JUMP FIN_MAYUS

VERIFICAR_MAYUS, LoadI PTR
				SUBT a // a = 97
				SkipCond 000// < 0
				JUMP RANGO_MINUS// VERIFICAR SI SIGUE EN RANGO DE MINUSCULAS
				JUMP SIG_MAYUS

RANGO_MINUS, LOADI PTR
			SUBT z // z = 122
			SKIPCOND 800 // > 0
			JUMP RESTA_32
			JUMP SIG_MAYUS

RESTA_32, LOADI PTR
			SUBT DIF
			STOREI PTR

SIG_MAYUS, LOAD PTR
			ADD UNO
			STORE PTR
			JUMP RECORRER_MAYUS

FIN_MAYUS, JumpI CONVERTIR_MAYUS

//IMPRIMIR
MOSTRAR, HEX 0
		LOAD INICIO_CADENA
		STORE PTR

CICLO, LOADI PTR
		SkipCond 400 //= 0
		JUMP IMPRIMIR
		JUMP MOSTRAR_FIN

IMPRIMIR, LOADI PTR
		OUTPUT
		LOAD PTR
		ADD UNO
		STORE PTR
		JUMP CICLO

MOSTRAR_FIN, JumpI MOSTRAR

			

		











		
		
		




PTR, HEX 00	
INICIO_CADENA, ADR CADENA	
/CADENA = "OrGaniZaciOn de Computadoras"	
CADENA, DEC 79	
DEC 114  	
DEC 71	 	
DEC 97			
DEC 110	
DEC 105	
DEC 90	
DEC 97	
DEC 99	
DEC 105	
DEC 79	
DEC 110	
DEC 32	
DEC 100	
DEC 101	
DEC 32	
DEC 67	
DEC 111	
DEC 109
DEC 112	
DEC 117	
DEC 116	
DEC 97	
DEC 100	
DEC 111	
DEC 114	
DEC 97	
DEC 115
DEC 32
DEC 10	
DEC 00	


//VARIABLES
OPC, DEC 0
UNO, DEC 1
DOS, DEC 2
TRES, DEC 3
CUATRO, DEC 4
A, DEC 65
Z,DEC 90
a, DEC 97
z, DEC 122 
DIF, DEC 32

